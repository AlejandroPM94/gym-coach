# Copy to .env and fill this value locally. Never commit the resulting file.
HEVY_API_KEY=
OPENAI_API_KEY=

GYM_COACH_ENVIRONMENT=development
GYM_COACH_LOG_LEVEL=INFO
GYM_COACH_DATABASE_URL=postgresql+psycopg://gym_coach:gym_coach@localhost:5432/gym_coach
GYM_COACH_HEVY_BASE_URL=https://api.hevyapp.com
GYM_COACH_HEVY_TIMEOUT_SECONDS=15
GYM_COACH_HEVY_RETRY_ATTEMPTS=3
GYM_COACH_HEVY_RETRY_BACKOFF_SECONDS=0.5
GYM_COACH_RAW_DATA_DIR=data/raw/hevy
GYM_COACH_OPENAI_MODEL=gpt-5.6-terra
GYM_COACH_OPENAI_REASONING_EFFORT=medium
